dist/
build/
coverage/
*.tsbuildinfo

# SQLite runtime databases (generated by `npm run seed` / `npm run db:migrate`)
*.db
*.db-shm
*.db-wal

# Logs
*.log

# OS / editor
.DS_Store
.vscode/
