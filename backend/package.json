{
  "name": "supplier-lens-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API server for Supplier Lens (subcontractor monitoring). Express + TypeScript + Drizzle/SQLite.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/services/registryProviders/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/runMigrate.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
