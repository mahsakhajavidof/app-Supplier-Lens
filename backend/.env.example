# Copy this file to .env and adjust as needed.

# SQLite file, relative to backend/. Zero setup — works out of the box.
# For production, point this at a Postgres connection string instead and
# change the `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

PORT=4000

# Optional: enables the UK Companies House registry integration.
# Get a free key at https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Optional: enables CompanyData.dk financial/ownership enrichment for Danish
# suppliers. Basic Danish company search and lookup (via the free, keyless
# APICVR) work without this — it only unlocks the extra enrichment step.
# Get a key at https://companydata.dk/ — restart the backend after setting it.
COMPANYDATA_DK_API_KEY=
